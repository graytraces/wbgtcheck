{
  "name": "wbgtcheck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "tsc -b --noEmit && vitest run",
    "test:watch": "vitest",
    "check:hscroll": "node scripts/checks/no-hscroll-sweep.mjs",
    "check:sharecard": "node scripts/checks/share-card-engine-check.mjs",
    "check:boot": "node scripts/checks/boot-failure-check.mjs",
    "check:print": "node scripts/checks/print-check.mjs",
    "check:browser": "npm run check:hscroll && npm run check:sharecard && npm run check:boot && npm run check:print"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.5",
    "@tailwindcss/vite": "^4.2.1",
    "clsx": "^2.1.1",
    "i18next": "^25.8.18",
    "lucide-react": "^0.575.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.0"
  }
}
